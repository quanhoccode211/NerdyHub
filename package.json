{
  "name": "edu-platform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "setup": "prisma migrate dev --name init && prisma db seed && node scripts/make-placeholder-audio.mjs",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:peek": "tsx scripts/db-peek.ts",
    "db:reset-attempts": "tsx scripts/db-reset-attempts.ts",
    "check:content-filter": "tsx scripts/check-content-filter.ts",
    "check:exam-flow": "tsx --conditions=react-server scripts/check-exam-flow.ts",
    "make:audio": "node scripts/make-placeholder-audio.mjs",
    "make:game-img": "node scripts/fetch-game-images.mjs",
    "gen:secrets": "node scripts/gen-secrets.mjs",
    "purge:users": "tsx scripts/purge-deleted-users.ts",
    "check:deletion": "tsx scripts/check-deletion-sla.ts"
  },
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.3",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "isomorphic-dompurify": "^3.22.0",
    "next": "16.3.1",
    "next-auth": "^5.0.0-beta.32",
    "prisma": "^7.9.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5"
  },
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "@prisma/engines@7.9.1": true,
    "prisma@7.9.1": true,
    "esbuild@0.28.2": true,
    "unrs-resolver@1.12.2": true
  }
}
