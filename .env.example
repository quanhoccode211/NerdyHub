# Chép file này thành `.env` rồi điền giá trị thật.
#   cp .env.example .env

# PostgreSQL — dùng cho CẢ máy dev lẫn bản chạy thật.
#
# Không còn SQLite: Vercel chạy serverless, mỗi request có thể rơi vào một máy
# khác và đĩa không giữ lại gì, nên một file .db không sống được ở đó. Provider
# của Prisma là hằng trong schema, không đọc được từ biến môi trường — nên máy
# dev cũng phải trỏ vào một Postgres thật (dùng nhánh dev riêng cho rẻ).
#
# Lấy chuỗi kết nối ở Neon, Supabase hoặc Vercel Postgres. Nhớ kèm sslmode:
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Hai khoá dưới đây KHÔNG tự điền bằng tay — chạy:
#   npm run gen:secrets
# AUTH_SECRET    ký/giải mã JWT session của Auth.js
# ENCRYPTION_KEY 32 byte hex, mã hoá token Google Calendar (AES-256-GCM)
AUTH_SECRET=
ENCRYPTION_KEY=

# Google OAuth — dùng cho đăng nhập Google và kết nối Google Calendar.
# Bỏ trống cũng chạy được: đăng ký/đăng nhập bằng email + mật khẩu vẫn đầy đủ,
# còn nút Google và thẻ kết nối lịch sẽ hiện trạng thái "chưa cấu hình".
# Các bước lấy hai giá trị này: docs/google-oauth-setup.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Gốc URL của site. Dùng cho metadataBase, sitemap và redirect URI của OAuth.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
